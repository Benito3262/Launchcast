# Never commit a real private key or seed phrase.
# Use a dedicated testnet wallet with no mainnet funds.
PRIVATE_KEY=
FEE_RECIPIENT=

# Historical archive RPCs. The secondary URL must be a different provider host.
# Resolver signing and attestation relaying fail closed unless both are configured.
ARCHIVE_RPC_URL=
SECONDARY_ARCHIVE_RPC_URL=

# Optional V2 contract address after the separate testnet deployment.
VITE_LAUNCHCAST_V2_ADDRESS=
