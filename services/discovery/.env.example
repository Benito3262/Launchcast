RPC_URL=https://rpc.testnet.chain.robinhood.com
# V2 historical FDV resolution requires an archive-capable Robinhood Chain RPC.
# Set this to an archive endpoint; Robinhood recommends Alchemy for chain infrastructure.
# Alchemy Testnet: https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>
# SolidRPC Testnet: https://rpc.solidrpc.io/<API_KEY>/evm/46630
# Verify historical state at the exact observation block before trusting a provider.
# ARCHIVE_RPC_URL=https://your-archive-rpc.example
CONFIRMATIONS=12
LOG_CHUNK_BLOCKS=20000

# V2 resolver (only after a reviewed V2 deployment)
LAUNCHCAST_V2_ADDRESS=0x0000000000000000000000000000000000000000
MAX_PRICE_STALENESS_SECONDS=3600
# Keep resolver signing keys in a secret manager; never commit them.
# RESOLVER_PRIVATE_KEY=0x...
LAUNCH_EVENT_LOOKBACK_BLOCKS=5000

# Permissionless attestation transaction sender (not a resolver signing key).
# Set only in a local secret manager after V2 deployment; never commit a real key.
# RELAYER_PRIVATE_KEY=0x...
