{
  "name": "launchcast-discovery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "discover": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "discover:full": "tsx src/index.ts --full-history",
    "test": "tsx --test src/*.test.ts",
    "discover:v6": "tsx src/index.ts --v6-only",
    "probe:curve-observation": "tsx src/probe-curve-observation.ts",
    "probe:v4-observation": "tsx src/probe-v4-observation.ts",
    "reconstruct:v6-supply": "tsx src/reconstruct-v6-supply.ts",
    "resolve:fdv": "tsx src/resolve-fdv.ts",
    "resolve:graduation": "tsx src/resolve-graduation.ts",
    "submit:attestation": "tsx src/submit-attestation.ts"
  },
  "dependencies": {
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
